{
  "name": "english-review-card-chatgpt-app",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node node_modules/typescript/bin/tsc",
    "dev": "npm run build && node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/tests/*.test.js scripts/*.test.mjs",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "smoke": "node scripts/smoke-mcp.mjs",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "express": "^5.1.0",
    "openai": "6.49.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
